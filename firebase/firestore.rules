rules_version = '2';

// Feedback from the Xfiles app (prod build with Firebase). The app may only CREATE a document in `feedback`.
// Nobody can read, update or delete feedback from the client; the team reads it in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    match /feedback/{feedbackId} {
      allow create: if validFeedback();
      allow read, update, delete: if false;
    }

    // Everything else is denied by default.
  }
}

function validFeedback() {
  let data = request.resource.data;
  let keys = data.keys();
  return keys.hasOnly([
      'category', 'message', 'createdAt', 'replyTo',
      'appVersion', 'versionCode', 'deviceModel', 'androidSdk', 'flavor', 'locale'
    ])
    && keys.hasAll(['category', 'message', 'createdAt'])
    // Required fields.
    && data.category in ['bug', 'idea', 'other']
    && data.message is string
    && data.message.size() > 0
    && data.message.size() <= 2000
    && data.createdAt == request.time
    // Optional reply address.
    && (!('replyTo' in keys) || (data.replyTo is string
        && data.replyTo.size() <= 254
        && data.replyTo.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')))
    // Optional device details, attached only when the user keeps the option on.
    && (!('appVersion' in keys) || (data.appVersion is string && data.appVersion.size() <= 40))
    && (!('versionCode' in keys) || (data.versionCode is int && data.versionCode >= 0))
    && (!('deviceModel' in keys) || (data.deviceModel is string && data.deviceModel.size() <= 100))
    && (!('androidSdk' in keys) || (data.androidSdk is int && data.androidSdk >= 0))
    && (!('flavor' in keys) || (data.flavor is string && data.flavor.size() <= 16))
    && (!('locale' in keys) || (data.locale is string && data.locale.size() <= 35));
}
